        for (let i = 0; i < inputFile.rows(); i++) {
            const row = inputFile.array(i);
            if (row.length < 3) continue;

            const azimuth = parseFloat(row[0]);
            const elevation = parseFloat(row[1]);
            const weight = parseFloat(row[2]);
